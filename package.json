{
  "name": "second-handstand",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-node-evidence.mjs && vite --config web/vite.config.ts",
    "build": "node scripts/build-node-evidence.mjs && tsc --noEmit && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "usage:update": "python3 scripts/update_usage_site.py",
    "usage:serve": "python3 scripts/update_usage_site.py --serve --port 5181",
    "usage:open": "python3 scripts/update_usage_site.py --serve --port 5181 --open"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@xyflow/react": "^12.10.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "replicate": "^1.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
}
